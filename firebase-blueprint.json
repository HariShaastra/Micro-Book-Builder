{
  "entities": {
    "book": {
      "title": "Book",
      "description": "Represents a document or manuscript project in Book Builder Shaastra.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "status": { "type": "string", "enum": ["idea", "draft", "in_progress", "review", "final", "archived"] },
        "type": { "type": "string" },
        "blueprintId": { "type": "string" },
        "description": { "type": "string" },
        "notes": { "type": "string" },
        "coverImage": { "type": "string" },
        "tags": { "type": "array" },
        "isFavorite": { "type": "boolean" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" },
        "userId": { "type": "string" },
        "authorName": { "type": "string" }
      },
      "required": ["id", "title", "status", "createdAt", "updatedAt", "userId"]
    },
    "chapter": {
      "title": "Chapter",
      "description": "A structured section, chapter, or block within a document.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "bookId": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "guidance": { "type": "string" },
        "status": { "type": "string" },
        "wordCount": { "type": "number" },
        "isBookmarked": { "type": "boolean" },
        "order": { "type": "number" }
      },
      "required": ["id", "bookId", "title", "order"]
    },
    "asset": {
      "title": "Asset",
      "description": "A file asset attached to a document.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "bookId": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string" },
        "url": { "type": "string" },
        "size": { "type": "number" }
      },
      "required": ["id", "bookId", "name", "type", "url"]
    }
  },
  "firestore": {
    "books": {
      "schema": "book",
      "description": "Collection of documents and manuscripts created by authors."
    },
    "books/{bookId}/chapters": {
      "schema": "chapter",
      "description": "Sub-collection of sections and chapters for a specific document."
    },
    "books/{bookId}/assets": {
      "schema": "asset",
      "description": "Sub-collection of assets for a specific document."
    }
  }
}
